{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: g++.exe 生成活动文件",
			"command": "d:\\Tools\\MinGW64\\bin\\g++.exe",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"${workspaceFolder}/main.cpp",
				"${workspaceFolder}/environment/winsockinitializer.cpp",
				"${workspaceFolder}/TcpServer/tcpserver.cpp",
				"-lws2_32",
				"-pthread",
				"-o",
				"${fileDirname}\\${fileBasenameNoExtension}.exe"
			],
			"options": {
				"cwd": "d:\\Tools\\MinGW64\\bin"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "编译器: d:\\Tools\\MinGW64\\bin\\g++.exe"
		}
	]
}